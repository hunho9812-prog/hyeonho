# ============================================================
# Supabase 환경변수 설정
#
# 1. https://supabase.com 에서 프로젝트 생성
# 2. supabase-schema.sql 을 SQL Editor에서 실행
# 3. Settings > API에서 아래 값을 복사해서 .env.local 파일 생성
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================
# 사이트 접근 비밀번호 (본인만 접근 가능하도록)
#
# 설정하면 /login 에서 비밀번호를 입력해야 다른 페이지에 접근 가능
# 미설정 시 게이트 없이 통과 (로컬 개발 편의)
# ============================================================
SITE_PASSWORD=your-own-password-here
